# Copy this file to .env on the server and fill in the real values.
# .env is git-ignored — never commit real secrets.

# Fergus Personal Access Token (Settings/Integration Centre -> Personal Access Tokens in Fergus).
# Treat this like a password: it grants API access to the whole Fergus account.
FERGUS_PAT=

# Usually no need to change this.
FERGUS_API_BASE_URL=https://api.fergus.com

# Port the relay server listens on (nginx proxies /api/ to this).
PORT=3001
